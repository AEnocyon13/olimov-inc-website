---
import '../styles/m3-color.css';
import '../styles/m3-sys.css';
import '../styles/m3-comp.css';
import '../styles/global.css';
import { t, HREF, HTML_LANG, LANGS, asset, type Lang } from '../i18n/content';
import TopAppBar from '../components/TopAppBar.astro';
import Footer from '../components/Footer.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const site = Astro.site ?? new URL('https://olimov-inc.example');
---
<!doctype html>
<html lang={HTML_LANG[lang]} class="no-js">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{d.meta.title}</title>
  <meta name="description" content={d.meta.description} />
  <!-- M3 surface role for each scheme -->
  <meta name="theme-color" content="#fff8f6" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#1e100d" media="(prefers-color-scheme: dark)" />
  <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
  <link rel="canonical" href={new URL(HREF[lang], site).href} />
  {LANGS.map((l) => (
    <link rel="alternate" hreflang={l} href={new URL(HREF[l], site).href} />
  ))}
  <link rel="alternate" hreflang="x-default" href={new URL(HREF.ja, site).href} />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={d.meta.title} />
  <meta property="og:description" content={d.meta.description} />
  <meta property="og:locale" content={lang === 'ja' ? 'ja_JP' : lang === 'ru' ? 'ru_RU' : 'en_US'} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <!-- Roboto Flex is M3's default typeface (Latin + Cyrillic);
       Noto Sans JP carries Japanese. -->
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&family=Roboto+Flex:opsz,wght@8..144,300..900&display=swap"
  />

  <script is:inline>
    (function () {
      var r = document.documentElement;
      r.classList.remove('no-js');
      try {
        if (window.CSS && CSS.supports('animation-timeline: view()')) r.classList.add('sda');
      } catch (e) {}
    })();
  </script>
</head>
<body>
  <a class="skip md-label-large" href="#main">{d.skip}</a>
  <TopAppBar lang={lang} />
  <main id="main"><slot /></main>
  <Footer lang={lang} />

  <script is:inline>
    // Reveal fallback for browsers without scroll-driven animations.
    (function () {
      var r = document.documentElement;
      if (r.classList.contains('sda')) return;
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var targets = document.querySelectorAll('.rv');
      if (!('IntersectionObserver' in window)) {
        targets.forEach(function (el) { el.classList.add('is-in'); });
        return;
      }
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (!e.isIntersecting) return;
          e.target.classList.add('is-in');
          io.unobserve(e.target);
        });
      }, { rootMargin: '0px 0px -12% 0px', threshold: 0.08 });
      targets.forEach(function (el) { io.observe(el); });
    })();
  </script>
</body>
</html>
