---
import { t, HREF, LANGS, LANG_NAMES, nameOf, addressOf, type Lang } from '../i18n/content';
import Mark from './Mark.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
---
<footer class="foot">
  <div class="wrap foot__grid">
    <div>
      <a class="foot__mark" href={HREF[lang]} aria-label={nameOf(lang)}>
        <Mark size={28} />
        <span class="md-title-large">OLIMOV <span class="foot__dim">CO., LTD.</span></span>
      </a>
      <p class="md-body-medium foot__tag">{d.footer.tagline}</p>
      <address class="md-body-small foot__addr">{addressOf(lang)}</address>
    </div>

    <nav class="foot__langs" aria-label="Language">
      <p class="md-label-large foot__label">Language</p>
      <ul class="md-list">
        {LANGS.map((l) => (
          <li>
            <a
              class="md-button md-button--text md-state foot__lang"
              href={HREF[l]} hreflang={l} lang={l}
              aria-current={l === lang ? 'true' : undefined}
            >{LANG_NAMES[l]}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="foot__legal">
      <p class="md-body-small">{d.footer.rights}</p>
      <p class="md-body-small foot__note">{d.footer.note}</p>
    </div>
  </div>
</footer>

<style>
  .foot {
    background: var(--md-sys-color-surface-container);
    color: var(--md-sys-color-on-surface);
    padding-block: var(--md-space-16) var(--md-space-12);
    border-start-start-radius: var(--md-sys-shape-corner-extra-large);
    border-start-end-radius: var(--md-sys-shape-corner-extra-large);
  }
  .foot__grid { display: grid; gap: var(--md-space-12); }
  @media (min-width: 900px) {
    .foot__grid { grid-template-columns: minmax(0, 1.4fr) auto minmax(0, 1fr); }
  }
  .foot__mark { display: inline-flex; align-items: center; min-height: 48px; gap: var(--md-space-3); }
  .foot__dim { color: var(--md-sys-color-on-surface-variant); }
  .foot__tag { color: var(--md-sys-color-on-surface-variant); margin-top: var(--md-space-4); max-width: 32ch; }
  .foot__addr { font-style: normal; color: var(--md-sys-color-on-surface-variant); margin-top: var(--md-space-4); max-width: 34ch; }

  .foot__label { color: var(--md-sys-color-on-surface-variant); margin-bottom: var(--md-space-2); }
  .foot__lang { justify-content: flex-start; padding-inline: var(--md-space-4); color: var(--md-sys-color-on-surface); }
  .foot__lang[aria-current='true'] { color: var(--md-sys-color-primary); }

  .foot__legal { display: flex; flex-direction: column; gap: var(--md-space-3); align-self: end; color: var(--md-sys-color-on-surface-variant); }
  .foot__note { max-width: 44ch; }
</style>
