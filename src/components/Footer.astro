---
import { t, HREF, LANGS, LANG_NAMES, nameOf, addressOf, type Lang } from '../i18n/content';
import Mark from './Mark.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
---
<footer class="foot">
  <div class="wrap">
    <hr class="hr" />
    <div class="foot__grid">
      <div class="foot__brand">
        <a class="foot__mark" href={HREF[lang]} aria-label={nameOf(lang)}>
          <Mark size={26} />
          <span>OLIMOV <span class="foot__dim">CO., LTD.</span></span>
        </a>
        <p class="foot__tag">{d.footer.tagline}</p>
        <address class="foot__addr">{addressOf(lang)}</address>
      </div>

      <nav class="foot__langs" aria-label="Language">
        <span class="micro foot__lbl">Language</span>
        <ul>
          {LANGS.map((l) => (
            <li>
              <a
                class:list={['ulink', { 'is-on': l === lang }]}
                href={HREF[l]} hreflang={l} lang={l}
                aria-current={l === lang ? 'true' : undefined}
              >{LANG_NAMES[l]}</a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="foot__legal">
        <p class="micro">{d.footer.rights}</p>
        <p class="micro foot__note">{d.footer.note}</p>
      </div>
    </div>
  </div>
</footer>

<style>
  .foot { padding-bottom: clamp(2rem, 5vw, 3.5rem); }
  .foot__grid {
    display: grid; gap: var(--sp-5) var(--sp-6);
    padding-top: clamp(2.5rem, 5vw, 4rem);
  }
  .foot .hr { background: var(--rule-strong); }
  @media (min-width: 860px) {
    .foot__grid { grid-template-columns: minmax(0, 1.4fr) auto minmax(0, 1fr); }
  }
  .foot__mark {
    display: inline-flex; align-items: center; gap: 0.7rem;
    font-family: var(--display); font-weight: 700; font-size: 1.0625rem; letter-spacing: -0.02em;
  }
  .foot__dim { color: var(--ink-3); font-weight: 500; }
  .foot__tag { color: var(--ink-3); font-size: 0.9375rem; margin-top: 0.85rem; max-width: 30ch; }
  .foot__addr {
    font-style: normal; color: var(--ink-3); font-size: 0.8125rem;
    line-height: 1.7; margin-top: 0.85rem; max-width: 32ch;
  }

  .foot__lbl { display: block; color: var(--ink-3); margin-bottom: 0.9rem; }
  .foot__langs ul { display: flex; flex-direction: column; gap: 0.45rem; font-size: 0.9375rem; }
  .foot__langs .is-on { color: var(--accent-ink); }

  .foot__legal { display: flex; flex-direction: column; gap: 0.85rem; align-self: end; }
  .foot__legal .micro { color: var(--ink-3); letter-spacing: 0.08em; }
  .foot__note { text-transform: none; letter-spacing: 0.01em; line-height: 1.7; max-width: 42ch; font-family: var(--body); }
</style>
