---
interface Props { size?: number; class?: string }
const { size = 22, class: cls = '' } = Astro.props;
---
<!-- Abrbandi: the tie-dyed diamond at the centre of an Uzbek ikat.
     Two of them, offset — two places, one form. -->
<svg class={cls} width={size} height={size} viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
  <path d="M8 2.5 13.5 12 8 21.5 2.5 12Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
  <path d="M16 5.5 21.5 12 16 18.5 12.5 12Z" fill="var(--accent)"/>
</svg>
