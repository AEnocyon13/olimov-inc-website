---
import { t, type Lang } from '../i18n/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
---
<section id="services" class="section">
  <div class="wrap">
    <header class="sec-head rv">
      <p class="md-label-large sec-head__over">{d.services.label}</p>
      <h2 class="md-headline-large md-emphasized sec-head__title">{d.services.title}</h2>
      <p class="md-body-large sec-head__support">{d.services.lead}</p>
    </header>

    <ul class="grid">
      {d.services.items.map((it, i) => (
        <li class="md-card md-card--outlined md-card--interactive card rv" data-d={String(Math.min(i + 1, 5))}>
          <p class="md-label-large card__no">{it.no}</p>
          <h3 class="md-title-large md-emphasized card__name">{it.name}</h3>
          <p class="md-body-medium card__desc">{it.desc}</p>
          <ul class="tags">
            {it.tags.map((tg) => <li class="md-chip md-chip--tonal">{tg}</li>)}
          </ul>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .grid { display: grid; gap: var(--md-space-4); }
  @media (min-width: 720px)  { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1240px) { .grid { grid-template-columns: repeat(3, 1fr); } }

  .card { padding: var(--md-space-6); display: flex; flex-direction: column; }
  @media (min-width: 840px) { .card { padding: var(--md-space-8); } }
  .card__no { color: var(--md-sys-color-primary); margin-bottom: var(--md-space-4); }
  .card__name { margin-bottom: var(--md-space-3); }
  .card__desc { color: var(--md-sys-color-on-surface-variant); margin-bottom: var(--md-space-6); }
  .tags { display: flex; flex-wrap: wrap; gap: var(--md-space-2); margin-top: auto; }
</style>
