---
import { t, type Lang } from '../i18n/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
---
<section id="services" class="section wrap">
  <div class="marker rv">
    <span class="marker__dot"></span>
    <span class="micro">{d.services.label}</span>
    <span class="marker__line"></span>
    <span class="micro tnum">{d.services.items.length.toString().padStart(2, '0')}</span>
  </div>

  <div class="sec__head">
    <h2 class="sec__title rvl">
      <span class="line"><span>{d.services.title}</span></span>
    </h2>
    <p class="lead rv" data-d="1">{d.services.lead}</p>
  </div>

  <ul class="rows">
    {d.services.items.map((it, i) => (
      <li class="row rv" data-d={String(Math.min(i + 1, 5))}>
        <span class="row__no micro tnum">{it.no}</span>
        <h3 class="row__name">{it.name}</h3>
        <p class="row__desc">{it.desc}</p>
        <ul class="tags">
          {it.tags.map((tg) => <li class="micro">{tg}</li>)}
        </ul>
      </li>
    ))}
  </ul>
</section>

<style>
  .sec__head {
    display: grid; gap: var(--sp-3) var(--sp-6);
    margin-bottom: clamp(3rem, 7vw, 5.5rem);
  }
  @media (min-width: 900px) {
    .sec__head { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); align-items: end; }
  }
  .sec__title { font-size: var(--fs-xl); }

  .rows { border-top: 1px solid var(--rule); }
  .row {
    display: grid; gap: 0.65rem var(--sp-4);
    grid-template-columns: minmax(0, 1fr);
    padding-block: clamp(1.75rem, 3.4vw, 2.75rem);
    border-bottom: 1px solid var(--rule);
    position: relative;
  }
  /* A vermilion wick that grows down the left edge on hover. */
  .row::before {
    content: ''; position: absolute; left: calc(var(--gutter) * -0.42); top: 0; bottom: 0;
    width: 2px; background: var(--accent);
    transform: scaleY(0); transform-origin: top;
    transition: transform 520ms var(--ease-out);
  }
  .row:hover::before { transform: scaleY(1); }
  @media (max-width: 899px) { .row::before { display: none; } }

  @media (min-width: 900px) {
    .row {
      grid-template-columns: 4rem minmax(0, 15rem) minmax(0, 1fr) minmax(0, 13rem);
      align-items: start;
    }
  }
  .row__no { color: var(--ink-3); padding-top: 0.5em; }
  .row__name { font-size: var(--fs-m); letter-spacing: -0.02em; line-height: 1.25; }
  .row__desc { color: var(--ink-2); max-width: 48ch; }

  .tags { display: flex; flex-wrap: wrap; gap: 0.4rem; align-content: start; }
  .tags li {
    padding: 0.42rem 0.7rem; border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--rule-soft);
    color: var(--ink-3); line-height: 1.2;
  }
  @media (prefers-reduced-motion: reduce) { .row::before { transition: none; } }
</style>
