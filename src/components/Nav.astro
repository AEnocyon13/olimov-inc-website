---
import { t, HREF, LANGS, LANG_SHORT, LANG_NAMES, type Lang } from '../i18n/content';
import Mark from './Mark.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const links = [
  { href: '#services', label: d.nav.services },
  { href: '#flows', label: d.nav.flows },
  { href: '#work', label: d.nav.work },
  { href: '#founder', label: d.nav.founder },
  { href: '#trust', label: d.nav.trust },
];
---
<header class="nav">
  <div class="nav__pill">
    <a class="nav__brand" href={HREF[lang]} aria-label="OLIMOV CO., LTD.">
      <Mark size={20} />
      <span class="nav__word">OLIMOV<span class="nav__word-dim"> CO., LTD.</span></span>
    </a>

    <nav class="nav__links" aria-label={d.nav.services}>
      {links.map((l) => <a class="nav__link" href={l.href}>{l.label}</a>)}
    </nav>

    <div class="nav__right">
      <ul class="langs" aria-label="Language">
        {LANGS.map((l) => (
          <li>
            <a
              class:list={['langs__a', { 'is-on': l === lang }]}
              href={HREF[l]}
              hreflang={l}
              lang={l}
              aria-current={l === lang ? 'true' : undefined}
              title={LANG_NAMES[l]}
            >{LANG_SHORT[l]}</a>
          </li>
        ))}
      </ul>
      <a class="nav__cta" href="#contact">{d.nav.contact}</a>

      <details class="menu">
        <summary class="menu__btn" aria-label={d.nav.services}>
          <span></span><span></span>
        </summary>
        <div class="menu__panel">
          {links.map((l) => <a href={l.href}>{l.label}</a>)}
          <a href="#contact" class="menu__cta">{d.nav.contact}</a>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  .nav {
    position: fixed; inset: 0 0 auto 0; z-index: var(--z-nav);
    padding: clamp(0.6rem, 1.6vw, 1.1rem) var(--gutter);
    pointer-events: none;
  }
  .nav__pill {
    pointer-events: auto;
    display: flex; align-items: center; gap: var(--sp-2);
    max-width: 78rem; margin-inline: auto;
    padding: 0.4rem 0.4rem 0.4rem 1rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--paper) 90%, transparent);
    box-shadow: inset 0 0 0 1px var(--rule-soft), 0 1px 2px rgb(12 12 13 / 0.03);
    backdrop-filter: blur(14px) saturate(1.4);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
  }
  /* Densify the pill as the page scrolls — compositor only, no JS. */
  @supports (animation-timeline: scroll()) {
    @keyframes nav-settle {
      to { box-shadow: inset 0 0 0 1px var(--rule), 0 8px 26px -14px rgb(12 12 13 / 0.4); }
    }
    .nav__pill {
      animation: nav-settle linear both;
      animation-timeline: scroll(root block);
      animation-range: 0 220px;
    }
  }

  .nav__brand { display: flex; align-items: center; gap: 0.6rem; flex: none; }
  .nav__word {
    font-family: var(--display); font-weight: 700; font-size: 0.9rem;
    letter-spacing: -0.02em; white-space: nowrap;
  }
  .nav__word-dim { color: var(--ink-3); font-weight: 500; }

  .nav__links { display: flex; gap: 0.35rem; margin-inline: auto; }
  .nav__link {
    display: inline-flex; align-items: center; min-height: 36px;
    padding: 0 0.85rem; border-radius: 999px;
    font-size: 0.8125rem; color: var(--ink-2);
    transition: color var(--t-fast) var(--ease-out), background-color var(--t-fast) var(--ease-out);
  }
  .nav__link:hover { color: var(--ink); background: var(--rule-soft); }

  .nav__right { display: flex; align-items: center; gap: 0.4rem; margin-left: auto; }

  .langs { display: flex; align-items: center; gap: 1px; padding: 2px; border-radius: 999px; background: var(--rule-soft); }
  .langs__a {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 34px; min-height: 32px; border-radius: 999px;
    font-family: var(--mono); font-size: 0.6875rem; font-weight: 500; letter-spacing: 0.06em;
    color: var(--ink-2);
    transition: color var(--t-fast) var(--ease-out), background-color var(--t-fast) var(--ease-out);
  }
  .langs__a:hover { color: var(--ink); }
  .langs__a.is-on { background: var(--ink); color: var(--paper); }

  .nav__cta {
    display: inline-flex; align-items: center; min-height: 40px;
    padding: 0 1.15rem; border-radius: 999px;
    background: var(--ink); color: var(--paper);
    font-size: 0.8125rem; font-weight: 600; white-space: nowrap;
    transition: background-color var(--t-mid) var(--ease-out);
  }
  .nav__cta:hover { background: var(--accent); }

  /* --- disclosure menu, small screens only --- */
  .menu { position: relative; display: none; }
  .menu__btn {
    display: flex; flex-direction: column; justify-content: center; gap: 5px;
    width: 40px; height: 40px; padding: 0 10px; border-radius: 999px;
    background: var(--rule-soft); cursor: pointer; list-style: none;
  }
  .menu__btn::-webkit-details-marker { display: none; }
  .menu__btn span { display: block; height: 1.5px; background: var(--ink); transition: transform var(--t-fast) var(--ease-out); }
  .menu[open] .menu__btn span:first-child { transform: translateY(3.25px) rotate(45deg); }
  .menu[open] .menu__btn span:last-child { transform: translateY(-3.25px) rotate(-45deg); }
  .menu__panel {
    position: absolute; right: 0; top: calc(100% + 0.6rem);
    min-width: 13rem; padding: 0.5rem; border-radius: 20px;
    display: flex; flex-direction: column;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--rule), 0 18px 40px -24px rgb(16 16 18 / 0.35);
  }
  .menu__panel a {
    display: flex; align-items: center; min-height: 44px; padding: 0 0.9rem;
    border-radius: 14px; font-size: 0.9375rem;
  }
  .menu__panel a:hover { background: var(--rule-soft); }
  .menu__cta { background: var(--ink); color: var(--paper); margin-top: 0.25rem; }
  .menu__cta:hover { background: var(--accent) !important; color: #fff; }

  @media (max-width: 1149px) {
    .nav__links { display: none; }
    .menu { display: block; }
  }
  @media (max-width: 479px) {
    .nav__cta { display: none; }
    .nav__word-dim { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .menu__btn span { transition: none; }
  }
</style>
