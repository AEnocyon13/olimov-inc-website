---
import { t, type Lang } from '../i18n/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const ax = d.hero.axis;
---
<section class="hero">
  <div class="wrap hero__inner">
    <p class="md-label-large hero__over load-in">{d.hero.eyebrow}</p>

    <h1 class="md-display-hero hero__title load-in" data-d="1">
      {d.hero.title.map((l) => <span class="hero__line">{l}</span>)}
    </h1>

    <p class="md-body-large hero__support load-in" data-d="2">{d.hero.lead}</p>

    <div class="hero__actions load-in" data-d="3">
      <a class="md-button md-button--filled md-button--large md-state" href="#contact">
        {d.hero.cta}
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
      <span class="md-body-small hero__note">{d.hero.ctaSub}</span>
    </div>

    <!-- Two directions of travel, drawn with the M3 linear progress
         indicator's track-and-indicator language. -->
    <figure class="md-card md-card--filled md-card--large axis load-in" data-d="4">
      <figcaption class="sr-only">
        {ax.left} → {ax.right}: {ax.out}. {ax.right} → {ax.left}: {ax.back}.
      </figcaption>

      <div class="axis__ends" aria-hidden="true">
        <span class="md-title-medium">{ax.left}</span>
        <span class="md-title-medium">{ax.right}</span>
      </div>

      <div class="lane lane--out" aria-hidden="true">
        <span class="lane__track"></span>
        <span class="lane__indicator"></span>
        <span class="lane__stop"></span>
      </div>
      <p class="md-label-large lane__label lane__label--out" aria-hidden="true">{ax.out}</p>

      <div class="lane lane--back" aria-hidden="true">
        <span class="lane__track"></span>
        <span class="lane__indicator"></span>
        <span class="lane__stop"></span>
      </div>
      <p class="md-label-large lane__label lane__label--back" aria-hidden="true">{ax.back}</p>
    </figure>
  </div>
</section>

<style>
  .hero {
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-top: clamp(96px, 14vh, 152px);
    padding-bottom: var(--md-space-16);
  }
  .hero__inner { width: 100%; }

  .hero__over { color: var(--md-sys-color-primary); margin-bottom: var(--md-space-6); }
  .hero__title { max-width: 18ch; margin-bottom: var(--md-space-8); }
  .hero__line { display: block; }
  :lang(en) .hero__title, :lang(ru) .hero__title { max-width: 14ch; }

  .hero__support {
    color: var(--md-sys-color-on-surface-variant);
    max-width: 60ch;
    margin-bottom: var(--md-space-8);
  }
  .hero__actions {
    display: flex;
    align-items: center;
    gap: var(--md-space-4) var(--md-space-6);
    flex-wrap: wrap;
    margin-bottom: var(--md-space-12);
  }
  .hero__note { color: var(--md-sys-color-on-surface-variant); }

  /* ---- axis ---- */
  .axis { padding: var(--md-space-6); margin: 0; }
  @media (min-width: 840px) { .axis { padding: var(--md-space-8); } }

  .axis__ends {
    display: flex;
    justify-content: space-between;
    margin-bottom: var(--md-space-6);
  }

  .lane { position: relative; height: 4px; }
  .lane__track {
    position: absolute;
    inset: 0;
    border-radius: var(--md-sys-shape-corner-full);
    background: var(--md-sys-color-surface-container-highest);
  }
  .lane__indicator {
    position: absolute;
    inset: 0;
    border-radius: var(--md-sys-shape-corner-full);
    transform: scaleX(0);
    animation: lane-fill var(--md-sys-motion-duration-extra-long4) var(--md-sys-motion-easing-emphasized) 500ms both;
  }
  .lane__stop {
    position: absolute;
    top: -2px;
    width: 8px;
    height: 8px;
    border-radius: var(--md-sys-shape-corner-full);
    opacity: 0;
    animation: lane-stop var(--md-sys-motion-duration-medium2) var(--md-sys-motion-easing-standard) 1400ms both;
  }

  .lane--out .lane__indicator { background: var(--md-sys-color-primary); transform-origin: left; }
  .lane--out .lane__stop { right: 0; background: var(--md-sys-color-primary); }
  .lane__label--out { color: var(--md-sys-color-primary); margin: var(--md-space-3) 0 var(--md-space-6); }

  .lane--back .lane__indicator { background: var(--md-sys-color-tertiary); transform-origin: right; animation-delay: 800ms; }
  .lane--back .lane__stop { left: 0; background: var(--md-sys-color-tertiary); animation-delay: 1700ms; }
  .lane__label--back {
    color: var(--md-sys-color-tertiary);
    margin: var(--md-space-3) 0 0;
    text-align: right;
  }

  @keyframes lane-fill { to { transform: scaleX(1); } }
  @keyframes lane-stop { to { opacity: 1; } }

  @media (prefers-reduced-motion: reduce) {
    .lane__indicator { transform: scaleX(1); animation: none; }
    .lane__stop { opacity: 1; animation: none; }
  }
</style>
