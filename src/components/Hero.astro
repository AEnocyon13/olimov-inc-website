---
import { t, type Lang } from '../i18n/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const ax = d.hero.axis;
---
<section class="hero">
  <div class="wrap hero__inner">
    <p class="micro hero__eyebrow fade-load">{d.hero.eyebrow}</p>

    <h1 class="hero__title in-load">
      {d.hero.title.map((l, i) => (
        <span class="line">
          <span>{l}{i === d.hero.title.length - 1 && <i class="hero__seal" aria-hidden="true"></i>}</span>
        </span>
      ))}
    </h1>

    <div class="hero__foot">
      <p class="lead hero__lead fade-load" data-d="1">{d.hero.lead}</p>
      <div class="hero__act fade-load" data-d="2">
        <a class="btn" href="#contact">
          {d.hero.cta}
          <svg class="btn__arrow" width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true">
            <path d="M1 7.5h12M8 2.5l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <span class="micro hero__ctasub">{d.hero.ctaSub}</span>
      </div>
    </div>

    <!-- The company's actual diagram: one axis, two directions of travel. -->
    <figure class="axis fade-load" data-d="3">
      <figcaption class="sr-only">
        {ax.left} → {ax.right}: {ax.out}. {ax.right} → {ax.left}: {ax.back}.
      </figcaption>

      <div class="axis__ends" aria-hidden="true">
        <span class="micro axis__city">{ax.left}</span>
        <span class="micro axis__city">{ax.right}</span>
      </div>

      <div class="lane lane--out" aria-hidden="true">
        <span class="lane__line"></span>
        <span class="lane__tip"></span>
      </div>
      <p class="micro lane__label lane__label--out" aria-hidden="true">{ax.out}</p>

      <div class="lane lane--back" aria-hidden="true">
        <span class="lane__line"></span>
        <span class="lane__tip"></span>
      </div>
      <p class="micro lane__label lane__label--back" aria-hidden="true">{ax.back}</p>
    </figure>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex; align-items: flex-end;
    padding-top: clamp(6.25rem, 12.5vh, 9.5rem);
    padding-bottom: clamp(2.25rem, 5vh, 4rem);
  }
  .hero__inner { width: 100%; }
  .hero__eyebrow { margin-bottom: clamp(1.25rem, 3.2vh, 2.5rem); }

  .hero__title {
    font-size: var(--fs-hero);
    line-height: 1.12;
    margin-bottom: clamp(1.75rem, 4vh, 3rem);
    max-width: 17ch;
  }
  :lang(en) .hero__title { max-width: 13ch; }
  :lang(ru) .hero__title { max-width: 13ch; font-size: clamp(2.25rem, 7.2vw, 7.25rem); }

  /* The ikat diamond, set as the final mark of the sentence. */
  .hero__seal {
    display: inline-block; vertical-align: 0.06em;
    margin-left: 0.3em;
    width: 0.26em; height: 0.26em; background: var(--accent);
    transform: rotate(45deg);
  }

  .hero__foot {
    display: grid; gap: var(--sp-4) var(--sp-5);
    grid-template-columns: minmax(0, 1fr);
    align-items: end;
    margin-bottom: clamp(2rem, 5vh, 3.5rem);
  }
  @media (min-width: 900px) {
    .hero__foot { grid-template-columns: minmax(0, 34rem) minmax(0, auto); justify-content: space-between; }
  }
  .hero__act { display: flex; flex-direction: column; align-items: flex-start; gap: 0.85rem; }
  .hero__ctasub { color: var(--ink-3); }

  /* ---- axis ---- */
  .axis { border-top: 1px solid var(--rule); padding-top: var(--sp-3); margin: 0; }
  .axis__ends { display: flex; justify-content: space-between; margin-bottom: 0.9rem; }
  .axis__city { color: var(--ink); font-weight: 500; }

  .lane { position: relative; height: 9px; }
  .lane__line {
    position: absolute; top: 4px; height: 1px;
    left: 0; right: 0;
    transform: scaleX(0);
    animation: lane-draw 1400ms var(--ease-io) 620ms both;
  }
  .lane__tip {
    position: absolute; top: 0.5px; width: 8px; height: 8px;
    border-style: solid; border-color: currentColor;
    animation: tip-in 420ms var(--ease-out) 1800ms both;
  }

  /* outbound: Japan → Uzbekistan, drawn left to right, in the accent */
  .lane--out { color: var(--accent); }
  .lane--out .lane__line { background: var(--accent); transform-origin: left; }
    /* Inset by 2px: the 45deg rotation grows the box past the line end
     and would otherwise widen the section's scrollWidth. */
  .lane--out .lane__tip { right: 2px; border-width: 1.5px 1.5px 0 0; transform: rotate(45deg); }
  .lane__label--out { color: var(--ink-2); margin: 0.5rem 0 1.15rem; }

  /* inbound: Uzbekistan → Japan, drawn right to left, in ink */
  .lane--back { color: var(--ink); }
  .lane--back .lane__line { background: var(--ink); transform-origin: right; animation-delay: 900ms; }
  .lane--back .lane__tip { left: 2px; border-width: 0 0 1.5px 1.5px; transform: rotate(45deg); animation-delay: 2100ms; }
  .lane__label--back { color: var(--ink-2); margin: 0.55rem 0 0; text-align: right; }

  @keyframes lane-draw { to { transform: scaleX(1); } }
  @keyframes tip-in { from { opacity: 0; } to { opacity: 1; } }

  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .lane__line { transform: scaleX(1); animation: none; }
    .lane__tip { opacity: 1; animation: none; }
  }
</style>
