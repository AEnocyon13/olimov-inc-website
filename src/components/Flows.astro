---
import { t, type Lang } from '../i18n/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
---
<section id="flows" class="section">
  <div class="wrap">
    <header class="sec-head rv">
      <p class="md-label-large sec-head__over">{d.flows.label}</p>
      <h2 class="md-headline-large md-emphasized sec-head__title">{d.flows.title}</h2>
      <p class="md-body-large sec-head__support">{d.flows.lead}</p>
    </header>

    <ul class="flows">
      {d.flows.items.map((f, i) => (
        <li class="md-card md-card--filled md-card--large flow rv" data-dir={f.dir} data-d={String(i + 1)}>
          <div class="flow__head">
            <p class="md-label-large flow__code">{f.code}</p>
            <h3 class="md-headline-small md-emphasized flow__name">{f.name}</h3>
            <p class="md-title-medium flow__route">
              <span>{f.from}</span>
              <span class="flow__glyph" aria-hidden="true">
                {f.dir === 'fwd' ? '→' : f.dir === 'rev' ? '←' : '⇄'}
              </span>
              <span>{f.to}</span>
            </p>
          </div>

          <div class="bar" aria-hidden="true">
            <span class="bar__track"></span>
            <span class="bar__indicator"></span>
          </div>

          <ul class="tags">
            {f.items.map((x) => <li class="md-chip">{x}</li>)}
          </ul>
          <p class="md-body-medium flow__note">{f.note}</p>
        </li>
      ))}
    </ul>

    <p class="md-body-small flows__note rv">{d.flows.note}</p>
  </div>
</section>

<style>
  .flows { display: grid; gap: var(--md-space-4); }
  .flow { padding: var(--md-space-6); min-width: 0; }
  .flow > * { min-width: 0; }
  @media (min-width: 840px) { .flow { padding: var(--md-space-8); } }

  .flow__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--md-space-2) var(--md-space-6);
    align-items: baseline;
    margin-bottom: var(--md-space-6);
  }
  .flow__code { color: var(--md-sys-color-primary); grid-column: 1 / -1; }
  .flow__route {
    display: flex;
    align-items: center;
    gap: var(--md-space-3);
    white-space: nowrap;
    color: var(--md-sys-color-on-surface-variant);
    justify-self: end;
  }
  .flow__glyph { color: var(--md-sys-color-primary); }
  @media (max-width: 719px) {
    .flow__head { grid-template-columns: minmax(0, 1fr); }
    .flow__route { justify-self: start; }
  }

  /* M3 linear progress indicator: track + indicator + stop. */
  .bar { position: relative; height: 4px; margin-bottom: var(--md-space-6); }
  .bar__track {
    position: absolute; inset: 0;
    border-radius: var(--md-sys-shape-corner-full);
    background: var(--md-sys-color-surface-container-highest);
  }
  .bar__indicator {
    position: absolute; inset: 0;
    border-radius: var(--md-sys-shape-corner-full);
    background: var(--md-sys-color-primary);
    transform: scaleX(0);
    transition: transform var(--md-sys-motion-duration-extra-long2) var(--md-sys-motion-easing-emphasized) 100ms;
  }
  [data-dir='fwd']  .bar__indicator { transform-origin: left; }
  [data-dir='rev']  .bar__indicator { transform-origin: right; background: var(--md-sys-color-tertiary); }
  [data-dir='both'] .bar__indicator { transform-origin: center; background: var(--md-sys-color-secondary); }
  .flow.is-in .bar__indicator { transform: scaleX(1); }

  @keyframes bar-fill { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @supports (animation-timeline: view()) {
    :global(.sda) .bar__indicator {
      transform: none; transition: none;
      animation: bar-fill linear both;
      animation-timeline: view();
      animation-range: entry 25% entry 95%;
    }
  }

  .tags { display: flex; flex-wrap: wrap; gap: var(--md-space-2); margin-bottom: var(--md-space-4); }
  .flow__note { color: var(--md-sys-color-on-surface-variant); max-width: 60ch; }
  .flows__note { color: var(--md-sys-color-on-surface-variant); margin-top: var(--md-space-6); }

  @media (prefers-reduced-motion: reduce) {
    .bar__indicator { transform: scaleX(1) !important; transition: none !important; animation: none !important; }
  }
</style>
