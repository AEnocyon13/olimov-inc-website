---
import { t, company, addressOf, type Lang } from '../i18n/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const offset = (tz: string) => Number(tz.replace('UTC', '')) || 0;
---
<section id="contact" class="section">
  <div class="wrap">
    <header class="sec-head rv">
      <p class="md-label-large sec-head__over">{d.contact.label}</p>
      <h2 class="md-headline-large md-emphasized sec-head__title">{d.contact.title}</h2>
      <p class="md-body-large sec-head__support">{d.contact.lead}</p>
    </header>

    <div class="grid">
      <div class="md-card md-card--filled md-card--large cta rv">
        <a class="md-fab md-fab--extended md-state" href={`mailto:${company.email}`}>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M3 7.5v9a1.5 1.5 0 0 0 1.5 1.5h15a1.5 1.5 0 0 0 1.5-1.5v-9M3 7.5A1.5 1.5 0 0 1 4.5 6h15A1.5 1.5 0 0 1 21 7.5M3 7.5l9 6 9-6"
              stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          {d.contact.emailLabel}
        </a>
        <p class="md-body-medium cta__mail">{company.email}</p>
      </div>

      <div class="side rv" data-d="1">
        <div class="md-card md-card--outlined side__card">
          <p class="md-label-large side__label">{d.contact.officeLabel}</p>
          <address class="md-body-medium side__addr">{addressOf(lang)}</address>
        </div>

        <div class="md-card md-card--outlined side__card">
          <p class="md-label-large side__label">{d.contact.hoursLabel}</p>
          <ul class="md-list">
            {d.contact.zones.map((z) => (
              <li class="md-list-item zone" data-utc={offset(z.tz)}>
                <div class="zone__head">
                  <h3 class="md-title-medium">{z.city}</h3>
                  <time class="md-label-large zone__clock tnum" data-clock>{z.tz}</time>
                </div>
                <p class="md-body-small md-list-item__supporting zone__role">{z.country} · {z.role}</p>
              </li>
            ))}
          </ul>
          <p class="md-body-small side__note">{d.contact.hoursNote}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  // Local time on both sides of the desk. Neither city observes DST, so a
  // fixed UTC offset is exact. Falls back to the printed "UTC+n".
  (function () {
    var nodes = document.querySelectorAll('.zone[data-utc]');
    if (!nodes.length) return;
    function tick() {
      var now = Date.now();
      nodes.forEach(function (el) {
        var d = new Date(now + Number(el.getAttribute('data-utc')) * 3600000);
        var h = String(d.getUTCHours()).padStart(2, '0');
        var m = String(d.getUTCMinutes()).padStart(2, '0');
        var out = el.querySelector('[data-clock]');
        if (out) { out.textContent = h + ':' + m; out.setAttribute('datetime', h + ':' + m); }
      });
    }
    tick();
    setInterval(tick, 20000);
  })();
</script>

<style>
  .grid { display: grid; gap: var(--md-space-4); }
  @media (min-width: 960px) { .grid { grid-template-columns: minmax(0, 1fr) minmax(0, 24rem); gap: var(--md-space-6); } }

  .cta {
    padding: var(--md-space-8);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: var(--md-space-6);
  }
  @media (min-width: 840px) { .cta { padding: var(--md-space-12); } }
  .cta__mail { color: var(--md-sys-color-on-surface-variant); }

  .side { display: grid; gap: var(--md-space-4); align-content: start; }
  .side__card { padding: var(--md-space-6); }
  .side__label { color: var(--md-sys-color-on-surface-variant); margin-bottom: var(--md-space-4); }
  .side__addr { font-style: normal; }
  .side__note { color: var(--md-sys-color-on-surface-variant); margin-top: var(--md-space-4); }

  .zone {
    grid-template-columns: minmax(0, 1fr);
    border-bottom: 1px solid var(--md-sys-color-outline-variant);
  }
  .zone:last-of-type { border-bottom: 0; }
  .zone__head { display: flex; align-items: baseline; justify-content: space-between; gap: var(--md-space-3); }
  .zone__clock { color: var(--md-sys-color-primary); }
  .zone__role { margin-top: var(--md-space-1); }
</style>
