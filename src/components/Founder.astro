---
import { t, type Lang } from '../i18n/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const f = t(lang).founder;
---
<section id="founder" class="section">
  <div class="wrap">
    <header class="sec-head rv">
      <p class="md-label-large sec-head__over">{f.label}</p>
      <h2 class="md-headline-large md-emphasized sec-head__title">{f.title}</h2>
      <p class="md-body-large sec-head__support">{f.lead}</p>
    </header>

    <div class="grid">
      <div class="md-card md-card--filled md-card--large who rv">
        <p class="md-headline-small md-emphasized who__name">{f.name}</p>
        {f.nameJa && <p class="md-body-medium who__kana">{f.nameJa}</p>}
        <p class="md-label-large who__role">{f.role}</p>
        <hr class="md-divider who__rule" />
        <p class="md-label-large who__langs-label">{f.langs.label}</p>
        <ul class="tags">
          {f.langs.items.map((l) => <li class="md-chip md-chip--tonal">{l}</li>)}
        </ul>
      </div>

      <div class="rv" data-d="1">
        <ol class="md-list tl">
          {f.timeline.map((row) => (
            <li class="md-list-item tl__row">
              <span class="md-label-large md-list-item__overline tl__year tnum">{row.year}</span>
              <span class="md-body-medium">{row.text}</span>
            </li>
          ))}
        </ol>
        <p class="md-body-medium founder__note">{f.note}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .grid { display: grid; gap: var(--md-space-6); }
  @media (min-width: 960px) { .grid { grid-template-columns: minmax(0, 24rem) minmax(0, 1fr); gap: var(--md-space-12); } }

  .who { padding: var(--md-space-6); align-self: start; }
  @media (min-width: 840px) { .who { padding: var(--md-space-8); } }
  .who__name { margin-bottom: var(--md-space-2); }
  .who__kana { color: var(--md-sys-color-on-surface-variant); }
  .who__role { color: var(--md-sys-color-primary); margin-top: var(--md-space-3); }
  .who__rule { margin-block: var(--md-space-6); }
  .who__langs-label { color: var(--md-sys-color-on-surface-variant); margin-bottom: var(--md-space-3); }
  .tags { display: flex; flex-wrap: wrap; gap: var(--md-space-2); }

  .tl__row {
    grid-template-columns: minmax(0, 5rem) minmax(0, 1fr);
    border-bottom: 1px solid var(--md-sys-color-outline-variant);
  }
  .tl__row:last-child { border-bottom: 0; }
  .tl__year { color: var(--md-sys-color-primary); }
  @media (max-width: 419px) { .tl__row { grid-template-columns: minmax(0, 1fr); } }

  .founder__note { color: var(--md-sys-color-on-surface-variant); margin-top: var(--md-space-6); max-width: 56ch; }
</style>
