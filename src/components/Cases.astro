---
import { t, type Lang } from '../i18n/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
---
<section id="work" class="section">
  <div class="wrap">
    <header class="sec-head rv">
      <p class="md-label-large sec-head__over">{d.work.label}</p>
      <h2 class="md-headline-large md-emphasized sec-head__title">{d.work.title}</h2>
      <p class="md-body-large sec-head__support">{d.work.lead}</p>
    </header>

    <ol class="cases">
      {d.work.cases.map((c, i) => (
        <li class="case" style={`--i:${i}`}>
          <article class="md-card md-card--elevated md-card--large card">
            <header class="card__head">
              <span class="md-label-large card__no">{c.no}</span>
              <span class="md-body-small card__meta">{c.year}</span>
              <span class="md-body-small card__meta card__place">{c.place}</span>
            </header>

            <div class="card__body">
              <div>
                <h3 class="md-headline-small md-emphasized card__title">{c.title}</h3>
                <p class="md-body-medium card__p">{c.body}</p>
              </div>

              <div class="spec">
                <p class="md-body-small spec__client">{c.client}</p>
                <hr class="md-divider" />
                <dl class="md-list spec__list">
                  {c.facts.map((f) => (
                    <div class="md-list-item spec__row">
                      <dt class="md-label-medium spec__k">{f.k}</dt>
                      <dd class="md-body-medium spec__v">{f.v}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            </div>
          </article>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .cases { display: grid; gap: var(--md-space-4); }
  .case { position: sticky; top: calc(80px + var(--i) * 12px); min-width: 0; }
  .card { padding: var(--md-space-6); transform-origin: 50% 0; }
  @media (min-width: 840px) { .card { padding: var(--md-space-8); } }

  @keyframes recede { to { transform: scale(0.96); opacity: 0.6; } }
  @supports (animation-timeline: view()) {
    :global(.sda) .card {
      animation: recede linear both;
      animation-timeline: view();
      animation-range: exit -18% exit 46%;
    }
  }

  .card__head {
    display: flex;
    align-items: center;
    gap: var(--md-space-3);
    flex-wrap: wrap;
    padding-bottom: var(--md-space-4);
    margin-bottom: var(--md-space-6);
    border-bottom: 1px solid var(--md-sys-color-outline-variant);
  }
  .card__no {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 32px;
    height: 32px;
    border-radius: var(--md-sys-shape-corner-full);
    background: var(--md-sys-color-primary);
    color: var(--md-sys-color-on-primary);
  }
  .card__meta { color: var(--md-sys-color-on-surface-variant); }
  .card__place { margin-left: auto; }

  .card__body { display: grid; gap: var(--md-space-8); }
  .card__body > * { min-width: 0; }
  @media (min-width: 960px) { .card__body { grid-template-columns: minmax(0, 1fr) minmax(0, 22rem); } }

  .card__title { margin-bottom: var(--md-space-4); max-width: 24ch; }
  .card__p { color: var(--md-sys-color-on-surface-variant); max-width: 60ch; }

  .spec { align-self: start; }
  .spec__client { color: var(--md-sys-color-primary); margin-bottom: var(--md-space-4); }
  .spec__row {
    grid-template-columns: minmax(0, 8rem) minmax(0, 1fr);
    min-height: 0;
    border-bottom: 1px solid var(--md-sys-color-outline-variant);
  }
  .spec__row:last-child { border-bottom: 0; }
  .spec__k { color: var(--md-sys-color-on-surface-variant); }
  .spec__v { margin: 0; }
  @media (max-width: 419px) { .spec__row { grid-template-columns: minmax(0, 1fr); } }

  @media (prefers-reduced-motion: reduce) {
    .case { position: static; }
    .card { animation: none !important; transform: none !important; opacity: 1 !important; }
  }
</style>
